# Copy to .env and fill in. Never commit .env.

# --- API keys ---------------------------------------------------------------
# AssemblyAI (recommended primary STT): https://www.assemblyai.com/dashboard
ASSEMBLYAI_API_KEY=
# Gemini (cleanup pass, and fallback STT): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- STT --------------------------------------------------------------------
# auto = AssemblyAI if its key is set, else Gemini
STT_PROVIDER=auto
ASSEMBLYAI_MODELS=universal-3-5-pro,universal-2
LANGUAGE_CODES=en,hi
# SPEAKERS_EXPECTED=2
GEMINI_STT_MODEL=gemini-3.5-transcribe
# Names / jargon that STT should get right (comma separated)
# KEYTERMS=Sharma Logistics,IFSC,UTR

# --- Pre-processing -----------------------------------------------------------
DENOISE=true

# --- LLM cleanup ------------------------------------------------------------
CLEANUP=true
# gemini-4-argon is most accurate but needs billing enabled on the key
CLEANUP_MODEL=gemini-3.6-flash
CLEANUP_FALLBACK_MODEL=gemini-3.5-flash
# roman (Hinglish, "kya hai") or devanagari ("क्या है"); English always stays in Latin script
HINDI_SCRIPT=roman
CHUNK_THRESHOLD_S=1200
CHUNK_LEN_S=600
CHUNK_OVERLAP_S=15
MAX_CONCURRENCY=2

# --- Call outcome analysis (real estate) ---------------------------------------
# Decides: site_visit_scheduled / interested / follow_up / not_interested / wrong_number / unclear
ANALYSIS=true
# Empty = same as CLEANUP_MODEL
ANALYSIS_MODEL=
# Helps the model with your project names, locations and agent names
# ANALYSIS_CONTEXT=Projects: Green Valley (Sector 150, Noida), Skyline Towers; agents: Rahul, Neha

# --- Review list --------------------------------------------------------------
LOW_CONFIDENCE=0.6
